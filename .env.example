# Banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/brasa_viva?schema=public"

# Redis (opcional para adapter Socket.IO em escala)
REDIS_URL="redis://localhost:6379"

# Auth.js (NextAuth v5)
AUTH_SECRET="brasa-viva-dev-secret-troque-em-producao-32chars"
AUTH_URL="http://localhost:3000"

# Provedor de Pagamento Pix ("mock" | "mercadopago")
PAYMENT_PROVIDER="mock"
PIX_WEBHOOK_SECRET="brasa-viva-webhook-secret"
MERCADOPAGO_ACCESS_TOKEN=""

# URL Pública da Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
